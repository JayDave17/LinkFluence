# MongoDB connection string.
#
# Local development:
#   MONGO_URI=mongodb://localhost:27017/linkfluence
#
# MongoDB Atlas (production / Railway) — note the database name at the end of
# the path. Both the app and the seeder read the name from this URI, so it must
# be present and it must be spelled consistently.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/linkfluence?retryWrites=true&w=majority

# Set to "true" for ONE deploy to insert the demo creator/business accounts,
# then set it back to "false". Leaving it on re-runs the seeder on every worker
# boot. The seeder is idempotent, but it is wasted startup work.
SEED_ON_STARTUP=false
